msgctxt "Addon Summary"
msgid "Nintendo - Game Boy Advance (mGBA)"
msgstr ""

msgctxt "Addon Description"
msgid "mGBA aims to be faster and more accurate than many existing Game Boy Advance emulators, as well as adding features that other emulators lack."
msgstr ""

msgctxt "#30001"
msgid "Game Boy Model (Restart)"
msgstr "Game Boy malli (Uudelleenkäynnistys)"

msgctxt "#30002"
msgid "Use BIOS File if Found (Restart)"
msgstr "Käytä BIOS-tiedostoa, mikäli se on läsnä (Uudelleenkäynnistys)"

msgctxt "#30003"
msgid "Skip BIOS Intro (Restart)"
msgstr "Ohita BIOS-alkulataus (Uudelleenkäynnistys)"

msgctxt "#30004"
msgid "Default Game Boy Palette"
msgstr "Game Boy:n oletus paletti"

msgctxt "#30005"
msgid "Hardware Preset Game Boy Palettes (Restart)"
msgstr ""

msgctxt "#30006"
msgid "Use Super Game Boy Borders (Restart)"
msgstr "Käytä Super Game Boy -kehyksiä (Uudelleenkäynnistys)"

msgctxt "#30011"
msgid "Allow Opposing Directional Input"
msgstr "Salli vastakkaisten suuntien syöte"

msgctxt "#30012"
msgid "Solar Sensor Level"
msgstr "Aurinkoanturin taso"

msgctxt "#30013"
msgid "Game Boy Player Rumble (Restart)"
msgstr "Game Boy Player tärinä (Uudelleenkäynnistys)"

msgctxt "#30014"
msgid "Idle Loop Removal"
msgstr "Joutosilmukan poisto"

msgctxt "#30015"
msgid "Frameskip"
msgstr "Kuvanohitus"

msgctxt "#30018"
msgid "System"
msgstr "Järjestelmä"

msgctxt "#30019"
msgid "Configure base hardware selection / BIOS parameters."
msgstr "Määritä peruslaitteiston valinta / BIOS-parametrit."

msgctxt "#30020"
msgid "Runs loaded content with a specific Game Boy model. 'Autodetect' will select the most appropriate model for the current game."
msgstr "Suorittaa ladattua sisältöä tietyllä Game Boy -mallilla. 'Havaitse automaattisesti' valitsee sopivimman mallin nykyiselle pelille."

msgctxt "#30021"
msgid "Use official BIOS/bootloader for emulated hardware, if present in RetroArch's system directory."
msgstr "Käytä virallista BIOS/bootloader -ohjelmaa emuloidulle laitteelle, mikäli ne löytyvät RetroArchin järjestelmäkansiosta."

msgctxt "#30022"
msgid "enabled"
msgstr "kyllä"

msgctxt "#30023"
msgid "disabled"
msgstr "ei"

msgctxt "#30024"
msgid "When using an official BIOS/bootloader, skip the start-up logo animation. This setting is ignored when 'Use BIOS File if Found' is disabled."
msgstr "Kun käytät virallista BIOS/bootloaderia, jätä käynnistyslogo-animaatio väliin. Tämä asetus ohitetaan, kun 'Käytä BIOS-tiedostoa, mikäli se on läsnä\" on pois päältä."

msgctxt "#30025"
msgid "Video"
msgstr ""

msgctxt "#30026"
msgid "Configure DMG palette / SGB borders."
msgstr "Määritä DMG paletti / SGB rajat / väri korjaus / LCD ghosting-efektit."

msgctxt "#30027"
msgid "Selects which palette is used for Game Boy games that are not Game Boy Color or Super Game Boy compatible, or if the model is forced to Game Boy."
msgstr ""

msgctxt "#30028"
msgid "Use the palettes for Game Boy games that have presets on the Game Boy Color or Super Game Boy."
msgstr ""

msgctxt "#30029"
msgid "Default Game Boy preset"
msgstr ""

msgctxt "#30030"
msgid "Game Boy Color presets only"
msgstr ""

msgctxt "#30031"
msgid "Super Game Boy presets only"
msgstr ""

msgctxt "#30032"
msgid "Any available presets"
msgstr ""

msgctxt "#30033"
msgid "Display Super Game Boy borders when running Super Game Boy enhanced games."
msgstr "Näytä Super Game Boy kehykset, kun ajetaan Super Game Boy tehostettuja pelejä."

msgctxt "#30034"
msgid "Audio"
msgstr "Ääni"

msgctxt "#30035"
msgid "Configure audio filtering."
msgstr "Määritä äänen suodatus."

msgctxt "#30036"
msgid "Low Pass Filter"
msgstr "Alipäästösuodatin"

msgctxt "#30037"
msgid "Enables a low pass audio filter to reduce the 'harshness' of generated audio."
msgstr "Ota käyttöön alipäästösuodatin vähentääksesi luodun äänen \"karkeutta\"."

msgctxt "#30038"
msgid "Filter Level"
msgstr "Suodatustaso"

msgctxt "#30039"
msgid "Specifies the cut-off frequency of the low pass audio filter. A higher value increases the perceived 'strength' of the filter, since a wider range of the high frequency spectrum is attenuated."
msgstr "Määritä alipäästösuodattimen katkaisu taajuus. Korkeampi arvo nostaa suodattimen \"vahvuutta\", koska suurempi osuus korkeamman taajuuden spektristä on vaimennettu."

