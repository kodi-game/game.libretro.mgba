msgctxt "Addon Summary"
msgid "Nintendo - Game Boy Advance (mGBA)"
msgstr ""

msgctxt "Addon Description"
msgid "mGBA aims to be faster and more accurate than many existing Game Boy Advance emulators, as well as adding features that other emulators lack."
msgstr "mGBA soll schneller und genauer sein als viele bestehende „Game Boy Advance“-Emulatoren und bietet darüber hinaus Funktionen, die anderen Emulatoren fehlen."

msgctxt "#30001"
msgid "Game Boy Model (Restart)"
msgstr "Game-Boy-Modell (Neustart erforderlich)"

msgctxt "#30002"
msgid "Use BIOS File if Found (Restart)"
msgstr "BIOS-Datei verwenden, sofern gefunden (Neustart erforderlich)"

msgctxt "#30003"
msgid "Skip BIOS Intro (Restart)"
msgstr "BIOS-Intro überspringen (Neustart erforderlich)"

msgctxt "#30004"
msgid "Default Game Boy Palette"
msgstr "Standard-Game-Boy-Palette"

msgctxt "#30005"
msgid "Hardware Preset Game Boy Palettes (Restart)"
msgstr "Hardware-Voreinstellung Game-Boy-Paletten (Neustart erforderlich)"

msgctxt "#30006"
msgid "Use Super Game Boy Borders (Restart)"
msgstr "Super-Game-Boy-Ränder verwenden (Neustart erforderlich)"

msgctxt "#30011"
msgid "Allow Opposing Directional Input"
msgstr "Gegenläufige Richtungen zulassen"

msgctxt "#30012"
msgid "Solar Sensor Level"
msgstr "Sonnensensorpegel"

msgctxt "#30013"
msgid "Game Boy Player Rumble (Restart)"
msgstr "Game-Boy-Spieler-Vibration (Neustart erforderlich)"

msgctxt "#30014"
