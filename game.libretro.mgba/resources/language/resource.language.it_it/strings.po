msgctxt "Addon Summary"
msgid "Nintendo - Game Boy Advance (mGBA)"
msgstr ""

msgctxt "Addon Description"
msgid "mGBA aims to be faster and more accurate than many existing Game Boy Advance emulators, as well as adding features that other emulators lack."
msgstr "mGBA punta a essere più veloce e più accurato di molti emulatori Game Boy Advance esistenti, oltre ad aggiungere funzionalità che altri emulatori non hanno."

msgctxt "#30001"
msgid "Game Boy Model (Restart)"
msgstr "Modello Game Boy (richiede riavvio)"

msgctxt "#30002"
msgid "Use BIOS File if Found (Restart)"
msgstr "Usa il File BIOS se Presente (richiede riavvio)"

msgctxt "#30003"
msgid "Skip BIOS Intro (Restart)"
msgstr "Salta Intro BIOS (richiede riavvio)"

msgctxt "#30004"
msgid "Default Game Boy Palette"
msgstr "Tavolozza Game Boy Predefinita"

msgctxt "#30005"
msgid "Hardware Preset Game Boy Palettes (Restart)"
msgstr "Tavolozze Game Boy preimpostate hardware (richiede riavvio)"

msgctxt "#30006"
msgid "Use Super Game Boy Borders (Restart)"
msgstr "Utilizza i Bordi Super Game Boy (richiede riavvio)"

msgctxt "#30011"
msgid "Allow Opposing Directional Input"
msgstr "Permetti Input Direzionali Opposti"

msgctxt "#30012"
msgid "Solar Sensor Level"
msgstr "Livello Sensore Solare"

msgctxt "#30013"
msgid "Game Boy Player Rumble (Restart)"
msgstr "Vibrazione Game Boy Player (Riavvio)"

msgctxt "#30014"
msgid "Idle Loop Removal"
msgstr "Rimozione Idle Loop"

msgctxt "#30015"
msgid "Frameskip"
msgstr "Salta Frame"

msgctxt "#30018"
msgid "System"
msgstr "Sistema"

msgctxt "#30019"
msgid "Configure base hardware selection / BIOS parameters."
msgstr "Configura i parametri di selezione hardware base / BIOS."

msgctxt "#30020"
msgid "Runs loaded content with a specific Game Boy model. 'Autodetect' will select the most appropriate model for the current game."
msgstr "Esegue il contenuto caricato con un modello specifico di Game Boy. 'Rivela Automaticamente' selezionerà il modello più appropriato per il gioco attuale."

msgctxt "#30021"
msgid "Use official BIOS/bootloader for emulated hardware, if present in RetroArch's system directory."
msgstr "Usa il BIOS/bootloader ufficiale per hardware emulato, se presente nella cartella di sistema di RetroArch."

msgctxt "#30022"
msgid "enabled"
msgstr "si"

msgctxt "#30023"
msgid "disabled"
msgstr ""

msgctxt "#30024"
msgid "When using an official BIOS/bootloader, skip the start-up logo animation. This setting is ignored when 'Use BIOS File if Found' is disabled."
msgstr "Salta il filmato del logo di avvio se si usa un BIOS/bootloader ufficiale. Questa impostazione è ignorata se 'Usa il file BIOS se presente' è disabilitato."

msgctxt "#30025"
msgid "Video"
msgstr ""

msgctxt "#30026"
msgid "Configure DMG palette / SGB borders."
msgstr "Configura i bordi della tavolozza DMG / SGB / correzione del colore / effetti fantasma LCD."

msgctxt "#30027"
msgid "Selects which palette is used for Game Boy games that are not Game Boy Color or Super Game Boy compatible, or if the model is forced to Game Boy."
msgstr "Seleziona quale tavolozza è utilizzata per i giochi Game Boy che non sono compatibili con Game Boy Color o Super Game Boy, o se il modello è costretto a Game Boy."

msgctxt "#30028"
msgid "Use the palettes for Game Boy games that have presets on the Game Boy Color or Super Game Boy."
msgstr ""

msgctxt "#30029"
msgid "Default Game Boy preset"
msgstr ""

msgctxt "#30030"
msgid "Game Boy Color presets only"
msgstr ""

msgctxt "#30031"
msgid "Super Game Boy presets only"
msgstr ""

msgctxt "#30032"
msgid "Any available presets"
msgstr ""

msgctxt "#30033"
msgid "Display Super Game Boy borders when running Super Game Boy enhanced games."
msgstr "Visualizza i bordi del Super Game Boy quando apri un gioco potenziato dal Super Game Boy."

msgctxt "#30034"
msgid "Audio"
msgstr ""

msgctxt "#30035"
msgid "Configure audio filtering."
msgstr "Configura il filtro audio."

msgctxt "#30036"
msgid "Low Pass Filter"
msgstr "Filtro Passaggio-basso"

msgctxt "#30037"
msgid "Enables a low pass audio filter to reduce the 'harshness' of generated audio."
msgstr "Abilita un filtro audio passaggio-basso per ridurre la 'durezza' dell'audio generato."

msgctxt "#30038"
msgid "Filter Level"
msgstr "Livello Filtro"

msgctxt "#30039"
msgid "Specifies the cut-off frequency of the low pass audio filter. A higher value increases the perceived 'strength' of the filter, since a wider range of the high frequency spectrum is attenuated."
msgstr "Specifica la frequenza di cut-off del filtro audio passa-basso. Un valore più elevato aumenta la 'forza' percepita del filtro, poiché una gamma più ampia dello spettro ad alta frequenza è attenuata."

