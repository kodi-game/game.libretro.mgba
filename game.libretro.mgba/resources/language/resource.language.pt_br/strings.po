msgctxt "Addon Summary"
msgid "Nintendo - Game Boy Advance (mGBA)"
msgstr ""

msgctxt "Addon Description"
msgid "mGBA aims to be faster and more accurate than many existing Game Boy Advance emulators, as well as adding features that other emulators lack."
msgstr ""

msgctxt "#30001"
msgid "Game Boy Model (Restart)"
msgstr "Modelo do Game Boy (requer reinício)"

msgctxt "#30002"
msgid "Use BIOS File if Found (Restart)"
msgstr "Usar arquivo de BIOS se encontrado (requer reinício)"

msgctxt "#30003"
msgid "Skip BIOS Intro (Restart)"
msgstr "Pular introdução da BIOS (requer reinício)"

msgctxt "#30004"
msgid "Default Game Boy Palette"
msgstr "Paleta padrão do Game Boy"

msgctxt "#30005"
msgid "Hardware Preset Game Boy Palettes (Restart)"
msgstr ""

msgctxt "#30006"
msgid "Use Super Game Boy Borders (Restart)"
msgstr "Usar bordas do Super Game Boy (requer reinício)"

msgctxt "#30011"
msgid "Allow Opposing Directional Input"
msgstr "Permitir entradas direcionais opostas"

msgctxt "#30012"
msgid "Solar Sensor Level"
msgstr "Nível do sensor solar"

msgctxt "#30013"
msgid "Game Boy Player Rumble (Restart)"
msgstr "Vibração do Game Boy Player (requer reinício)"

msgctxt "#30014"
msgid "Idle Loop Removal"
msgstr "Remover loops de inatividade"

msgctxt "#30015"
msgid "Frameskip"
msgstr "Pulo de quadro"

msgctxt "#30018"
msgid "System"
msgstr "Sistema"

msgctxt "#30019"
msgid "Configure base hardware selection / BIOS parameters."
msgstr "Configura os parâmetros de seleção do hardware base e da BIOS."

msgctxt "#30020"
msgid "Runs loaded content with a specific Game Boy model. 'Autodetect' will select the most appropriate model for the current game."
msgstr "Executa o conteúdo carregado utilizando um modelo de Game Boy específico. 'Detectar automaticamente' selecionará o modelo mais apropriado para o jogo atual."

msgctxt "#30021"
msgid "Use official BIOS/bootloader for emulated hardware, if present in RetroArch's system directory."
msgstr "Usa a BIOS/carregador de inicialização oficial para o hardware emulado, se estiver presente no diretório de sistema do RetroArch."

msgctxt "#30022"
msgid "enabled"
msgstr "sim"

msgctxt "#30023"
msgid "disabled"
msgstr "não"

msgctxt "#30024"
msgid "When using an official BIOS/bootloader, skip the start-up logo animation. This setting is ignored when 'Use BIOS File if Found' is disabled."
msgstr "Ao usar uma BIOS e um carregador de inicialização oficial, omitirá a animação do logotipo na inicialização. Esta configuração será ignorada caso 'Usar arquivo de BIOS se encontrado' estiver desativada."

msgctxt "#30025"
msgid "Video"
msgstr "Vídeo"

msgctxt "#30026"
msgid "Configure DMG palette / SGB borders."
msgstr "Configura a paleta de modelos DMG, as bordas do SGB, a correção de cor e os efeitos fantasmas do LCD."

msgctxt "#30027"
msgid "Selects which palette is used for Game Boy games that are not Game Boy Color or Super Game Boy compatible, or if the model is forced to Game Boy."
msgstr "Seleciona a paleta que será usada com jogos de Game Boy que não são compatíveis com Game Boy Color ou Super Game Boy ou ao forçar o modelo a Game Boy."

msgctxt "#30028"
msgid "Use the palettes for Game Boy games that have presets on the Game Boy Color or Super Game Boy."
msgstr ""

msgctxt "#30029"
msgid "Default Game Boy preset"
msgstr ""

msgctxt "#30030"
msgid "Game Boy Color presets only"
msgstr ""

msgctxt "#30031"
msgid "Super Game Boy presets only"
msgstr ""

msgctxt "#30032"
msgid "Any available presets"
msgstr ""

msgctxt "#30033"
msgid "Display Super Game Boy borders when running Super Game Boy enhanced games."
msgstr "Exibe as bordas do Super Game Boy ao jogar jogos compatíveis com esse sistema."

msgctxt "#30034"
msgid "Audio"
msgstr "Áudio"

msgctxt "#30035"
msgid "Configure audio filtering."
msgstr "Configura o filtro de áudio."

msgctxt "#30036"
msgid "Low Pass Filter"
msgstr "Filtro passa-baixo"

msgctxt "#30037"
msgid "Enables a low pass audio filter to reduce the 'harshness' of generated audio."
msgstr "Ativa um filtro passa-baixo de áudio para reduzir a estridência do áudio gerado."

msgctxt "#30038"
msgid "Filter Level"
msgstr "Nível do filtro"

msgctxt "#30039"
msgid "Specifies the cut-off frequency of the low pass audio filter. A higher value increases the perceived 'strength' of the filter, since a wider range of the high frequency spectrum is attenuated."
msgstr "Especifica a frequência de corte do filtro de áudio passa-baixo. Um valor mais alto aumenta a 'força' percebida do filtro, uma vez que uma faixa mais ampla do espectro de alta frequência é atenuada."

