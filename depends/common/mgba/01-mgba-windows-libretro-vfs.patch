From b68ec82bdafe4a9eaa65209c06392f00c90e2ca6 Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Fri, 13 Nov 2026 07:02:08 +0000
Subject: [PATCH] Leave the Windows directory code out of the libretro core

The Windows OS_SRC glob picks up vfs-w32.c too, so the libretro core
compiles it, but the core only defines ENABLE_VFS, not
ENABLE_DIRECTORIES, so struct VDir and VDirEntry don't exist there.
vfs-w32.c is still listed in VFS_SRC for the builds that use it.
---
 CMakeLists.txt | 1 +
 1 file changed, 1 insertion(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index cd21282..5abd3f7 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -230,6 +230,7 @@ if(WIN32)
 	list(APPEND CORE_VFS_SRC ${CMAKE_CURRENT_SOURCE_DIR}/src/util/vfs/vfs-fd.c)
 	list(APPEND VFS_SRC ${CMAKE_CURRENT_SOURCE_DIR}/src/platform/windows/vfs-w32.c)
 	file(GLOB OS_SRC ${CMAKE_CURRENT_SOURCE_DIR}/src/platform/windows/*.c)
+	list(REMOVE_ITEM OS_SRC ${CMAKE_CURRENT_SOURCE_DIR}/src/platform/windows/vfs-w32.c)
 	source_group("Windows-specific code" FILES ${OS_SRC})
 elseif(UNIX)
 	set(USE_PTHREADS ON)
-- 
